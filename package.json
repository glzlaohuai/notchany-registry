{
  "name": "notchany-registry",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-pr.mjs",
    "build:index": "node scripts/build-index.mjs && node scripts/build-history.mjs",
    "build:site": "node scripts/build-site.mjs",
    "notify:release": "node scripts/notify-release.mjs",
    "reconcile:market": "node scripts/reconcile-market.mjs",
    "build": "npm run check && npm run build:index && npm run build:site",
    "test": "node --test tests/*.test.mjs"
  }
}
